# Server-side AI Provider Secrets (configure in Settings > Secrets or .env)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HARBOR_API_KEY=
HARBOR_BASE_URL=
CUSTOM_LLM_API_KEY=

# Optional Companion Python PyTorch Inference Engine URL (runs /ml_engine/server.py)
PYTORCH_ENGINE_URL=http://127.0.0.1:8001

# Optional GitHub Release ZIP URL for /ml_engine/ automatic artifact download
GITHUB_ARTIFACTS_ZIP_URL=

# Optional AES-256-GCM encryption secret for local gateway state
AEGIS_VAULT_SECRET=
